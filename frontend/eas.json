{
  "cli": {
    "version": ">= 2.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "apk": {
      "distribution": "internal",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "http://192.168.1.40:8000"
      },
      "android": {
        "image": "sdk-55",
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "http://192.168.1.40:8000"
      },
      "android": {
        "image": "sdk-55",
        "buildType": "app-bundle",
        "gradleCommand": ":app:bundleRelease --stacktrace --info"
      }
    },
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "http://192.168.1.40:8000"
      },
      "android": {
        "buildType": "apk"
      }
    }
  }
}
